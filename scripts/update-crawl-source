#! /usr/bin/env bash

git_url=https://github.com/crawl/crawl.git
source_dir=current
lock_dir="$PWD/.crawl-fetch.lock"
num_threads=$(nproc)
make_args=

set -o errexit -o pipefail

while getopts "h?g:j:l:m:s:" opt; do
    case "$opt" in
        h|\?)
            echo "$0 [-s <dir>] [-g <url> ] [-l <dir>]" \
                " [-j <num>] [-m <args>]"
            exit 0
            ;;
        g)  git_url="$OPTARG"
            ;;
        j)  num_threads="$OPTARG"
            ;;
        l)  lock_dir="$OPTARG"
            ;;
        m)  make_args="$OPTARG"
            ;;
        s)  source_dir="$OPTARG"
            ;;
    esac
done

while ! mkdir $lock_dir 2>/dev/null; do
    echo >&2 "Unable to lock $lock_dir, waiting..."
    sleep 5
done

cleanup_lock() {
    rmdir $lock_dir
}

trap cleanup_lock EXIT

if [[ ! -d "$source_dir" ]]; then
    git clone $git_url $source_dir
fi

cd $source_dir
git checkout -f
git clean -fx -e crawl.build
git pull
git submodule update --init

cd crawl-ref
# ctags incantations courtesy |amethyst
ctags -R \
    --langdef=crawlmap \
    --langmap=crawlmap:+.des \
    --regex-crawlmap='/^ *NAME: *([^ ]*)/\1/q,map,map definition/' \
    --regex-c++='/^ *DEF_BITFIELD *\( *([a-zA-Z0-9_:]*)/\1/t/' \
    --regex-c++='/^ *\{ *\/\/ Book of (.*)/\1/t/i' \
    --regex-c++='/^ *\{ *\/\/ (.*)/\1/t/i' \
    -I decltype+ \
    -I PURE -I IMMUTABLE -I override \
    --extras=+q \
    --exclude=contrib \
    --exclude=android-project \
    --exclude=saves \
    --exclude='tiledef-*' \
    *

# And compile the binary for playable:*
cd source
make clean
make -j$num_threads $make_args

if [[ -f crawl ]]; then
    mv crawl crawl.build
fi
