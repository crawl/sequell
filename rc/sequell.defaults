# Defaults, affect all configs unless overridden in the config.

# Authenticate the bot itself with NickServe. If false, use PASS
# authentication. The password must be stored in the Sequell directory in the
# file password.txt. Your nick must be registered in order for it to
# authenticate.
nickserv_login: true

use_pm: false

# A name for the bot's lockfile.
lock_name: sequell

sql_queries: true
sql_store: true
learndb: true

# Record the last time a user was seen on a public IRC channel.
seen_update: false

# Check messages beginning with these sigils for commands.
sigils: "!@#$%&=;.,\\^?-"
preferred_sigil: "!"

commands_file: config/commands-sequell.txt
public_commands_file: config/public_commands.txt
